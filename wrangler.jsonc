{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "kuraattori",
	"compatibility_date": "2026-09-26",
	"routes": [{ "pattern": "kuraattori.emialis.com", "custom_domain": true }],
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			// Local dev only: this id is a placeholder, not a real Cloudflare
			// database. Replace it with the id from `wrangler d1 create` before
			// any remote deploy.
			"binding": "DB",
			"database_name": "kuraattori",
			"database_id": "04d53796-2160-455d-ba5e-0fb4f6bee0b7",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [
		{
			// Local dev only: this id is a placeholder, not a real Cloudflare KV
			// namespace. Replace it with the id from
			// `wrangler kv namespace create CACHE` before any remote deploy.
			// Caches public reads (regions, museums, categories, the active-
			// exhibition pool); see src/server/cache/kv-cache.ts. Code degrades
			// to uncached reads if this binding is ever absent.
			"binding": "CACHE",
			"id": "0000000000000000000000000000c6"
		}
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "kuraattori"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
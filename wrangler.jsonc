{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "kuraattori",
	"compatibility_date": "2026-09-26",
	"routes": [{ "pattern": "kuraattori.emialis.com", "custom_domain": true }],
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"observability": {
		// Workers Logs: free-tier, needed for `wrangler tail`/the dashboard to
		// show anything a request logs.
		"enabled": true
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kuraattori",
			"database_id": "04d53796-2160-455d-ba5e-0fb4f6bee0b7",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [
		{
			// Caches public reads (regions, museums, categories, the active-
			// exhibition pool); see src/server/cache/kv-cache.ts. Code degrades
			// to uncached reads if this binding is ever absent.
			"binding": "CACHE",
			"id": "90ab6e16443148e0a8ab33f924c64fea"
		}
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "kuraattori"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"limits": {
		// About 3× the measured p99 CPU time per request; see
		// issues/39-cost-guardrails.md for the measurement.
		"cpu_ms": 1100
	}
}